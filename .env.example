# Copy this file to .env and fill in real values; .env is never committed.

# Docker Compose: local Postgres credentials
POSTGRES_DB=opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=change-me

# Django -> Docker Postgres (host side)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# LLM: provider:model (optional, default groq:openai/gpt-oss-120b) and its key (LLM_API_KEY or GROQ_API_KEY)
# LLM_MODEL=groq:openai/gpt-oss-120b
# Optional smaller/faster model for the guardrail classifier (default: LLM_MODEL)
# LLM_GUARD_MODEL=groq:openai/gpt-oss-20b   (llama-3.1-8b-instant was removed from Groq; this model has its own quota)
# Retries on rate limits (429); multi-agent turns make several LLM calls at once
# LLM_MAX_RETRIES=6
# LLM_TIMEOUT_SECONDS=60
# Local embedding model for RAG (downloaded once into .cache/fastembed, ~0.22 GB)
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
GROQ_API_KEY=gsk_change-me

# Kafka and Redis (optional; these are the docker-compose defaults)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# REDIS_URL=redis://localhost:6379/0

# Lesson 16B: one triage LLM call instead of input guard + supervisor (set false for the old two-call flow)
# ORCHESTRATOR_TRIAGE=true

# LLM tracing to LangSmith cloud (https://smith.langchain.com -> Settings -> API Keys)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=opspilot-dev
# Phones/emails/CNICs are masked before traces leave the process; set false only for fake/demo data
# LANGSMITH_MASK_PII=true

# Lesson 16B switches (each optimization can be measured on/off as its own experiment)
# RAG_SEARCH_LIMIT=3
# RAG_SKIP_CONFIDENT_GRADE=true
# Earlier conversation a specialist sees (long chats otherwise pass the model's request limit)
# CHAT_HISTORY_MAX_TOKENS=2000

# Signs login tokens. Generate your own: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-long-random-string-at-least-32-characters
# Password seed_data gives the fake demo customers and staff (local testing only)
DEMO_PASSWORD=change-me-local-demo-password
