# Copy this file to .env and fill in real values; .env is never committed.

# Docker Compose: local Postgres credentials
POSTGRES_DB=opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=change-me

# Django -> Docker Postgres (host side)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# LLM: provider:model (optional, default groq:openai/gpt-oss-120b) and its key (LLM_API_KEY or GROQ_API_KEY)
# LLM_MODEL=groq:openai/gpt-oss-120b
# Optional smaller/faster model for the guardrail classifier (default: LLM_MODEL)
# LLM_GUARD_MODEL=groq:llama-3.1-8b-instant
# Retries on rate limits (429); multi-agent turns make several LLM calls at once
# LLM_MAX_RETRIES=6
# Local embedding model for RAG (downloaded once into .cache/fastembed, ~0.22 GB)
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
GROQ_API_KEY=gsk_change-me

# Kafka and Redis (optional; these are the docker-compose defaults)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# REDIS_URL=redis://localhost:6379/0

# LLM tracing to self-hosted Langfuse (start it: docker compose --profile observability up -d, UI http://localhost:3100)
# The keys below match the local defaults in docker-compose.yml; login: dev@opspilot.example / opspilot-local-dev
# LANGFUSE_ENABLED=true
# LANGFUSE_HOST=http://localhost:3100
# LANGFUSE_PUBLIC_KEY=pk-lf-opspilot-local
# LANGFUSE_SECRET_KEY=sk-lf-opspilot-local

# Staff approval API (temporary until JWT roles): sent as header X-Staff-Key
STAFF_API_KEY=change-me-long-random-string
