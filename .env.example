# Copy this file to .env and fill in real values; .env is never committed.

# Docker Compose: local Postgres credentials
POSTGRES_DB=opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=change-me

# Django -> Docker Postgres (host side)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# LLM: provider:model (optional, default groq:openai/gpt-oss-120b) and its key (LLM_API_KEY or GROQ_API_KEY)
# LLM_MODEL=groq:openai/gpt-oss-120b
GROQ_API_KEY=gsk_change-me
